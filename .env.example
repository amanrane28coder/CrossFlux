# Copy to .env for local use, then load it in your shell before starting.
# These are placeholders for simulation/research. They do not enable live orders.
# Capital must use the quote currency of realized PnL. Do not assume USDT == USD.
CROSSFLUX_INITIAL_CAPITAL=100000
CROSSFLUX_MAX_DRAWDOWN_PCT=5.0

# Optional model configuration; valid preset/profile names are documented in src/.
CROSSFLUX_FEE_PRESET=retail
CROSSFLUX_FRICTION_PRESET=stress
CROSSFLUX_OBI_PROFILE=flat

# Logging: text or json; standard Python levels such as INFO, WARNING, DEBUG.
CROSSFLUX_LOG_FORMAT=json
CROSSFLUX_LOG_LEVEL=INFO

# Optional Prometheus scrape endpoint for the Python market-data simulator.
# It defaults to loopback and disabled; do not expose it publicly without auth.
CROSSFLUX_METRICS_ENABLED=false
CROSSFLUX_METRICS_HOST=127.0.0.1
CROSSFLUX_METRICS_PORT=9108
